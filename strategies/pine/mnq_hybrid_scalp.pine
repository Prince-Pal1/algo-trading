//@version=5
// ============================================================================
// MNQ Hybrid Scalp - "Trader MNQ" (IQ Capital video, reverse-engineered)
//
// Two independent modules on the 5-minute chart:
//
//   LONG   ATR band scalp. A limit buy rests on the lower band
//          (previous close - 3.1 x ATR) and follows it every candle.
//          Static exits: +2.0 ATR target, -1.5 ATR stop, both using the
//          PREVIOUS closed candle's ATR and locked the moment the order fills.
//
//   SHORT  Shooting-star scalp. No ATR bands. After a long-upper-wick candle
//          closes, sell at the next open and buy back at the open after that:
//          a one-candle, 5-minute hold. There is no target.
//
// Sources: the video transcript, with timestamps in the comments below.
//
// -- What the video does NOT say, and what this script assumes -------------
//   * Which "opening candle": assumed 09:30 New York (input).
//   * Trading hours: not stated, so all hours by default (optional window).
//   * ATR smoothing: not stated. ta.atr() (RMA/Wilder), the same ATR TradingView's own indicator draws.
//   * Short sizing distance: not stated, so 1.5 x ATR (same as the long).
//   * Overlap: not stated. One position at a time; a short signal pulls the
//     long limit for the single candle the short is held.
//   * Fewer than 1 contract: the trade is skipped. Rounding up to 1 would
//     break the loss limit the sizing exists to respect.
//   * The shooting-star thresholds are the VIDEO CREATOR's rule, not the
//     trader's. The trader eyeballs the candle (17:35-18:24).
//
// -- To reproduce the video's backtests -----------------------------------
//   Tick "Use fixed contracts", set 4. Test one module at a time. For the short,
//   turn "Max-loss stop" OFF. The video's settings for costs and date range
//   are unknown, so expect the same shape of result, not the same numbers.
//   Video long:  PF 1.527, ~50% win rate, max DD $2,614
//   Video short: PF 1.413,  52% win rate, max DD $1,142 (22:42)
// ============================================================================

// Declaration notes:
//   initial_capital  100000: IQ Capital 100K account.
//   commission       $0.62 per contract per side. Set 0 in Properties for an idealised test.
//   slippage         1 tick. Applies to market and stop orders, not to limits.
//   margin           OFF (0). TradingView's default margin (100% of notional) would
//                    force-liquidate futures: one MNQ is ~$40k of notional, so a 100K
//                    account "runs out of margin" at 2-3 contracts.
//   bar magnifier    ON. On a 5-minute chart TradingView can't tell whether the target
//                    or the stop was hit first when both sit inside one candle; the
//                    magnifier resolves it from lower-timeframe data (Premium plans).
//   process_orders_on_close = false: market orders fill at the NEXT candle's open.
strategy("MNQ Hybrid Scalp - ATR Band Long / Shooting Star Short", shorttitle = "MNQ Hybrid Scalp", overlay = true, initial_capital = 100000, currency = currency.USD, pyramiding = 0, commission_type = strategy.commission.cash_per_contract, commission_value = 0.62, slippage = 1, margin_long = 0, margin_short = 0, use_bar_magnifier = true, process_orders_on_close = false, calc_on_every_tick = false)

// -------------------------------------------------------------------------
// INPUTS
// -------------------------------------------------------------------------
grpL = "Long - ATR band scalp"
longOn    = input.bool(true, "Enable long module", group = grpL)
atrLen    = input.int(14, "ATR length", minval = 1, group = grpL, tooltip = "Video 11:55: period 14.")
bandMult  = input.float(3.1, "Band multiplier (x ATR)", step = 0.1, group = grpL, tooltip = "Video 11:55: scale factor 3.1.")
tpMult    = input.float(2.0, "Target (x ATR)", step = 0.1, group = grpL)
slMult    = input.float(1.5, "Stop (x ATR)", step = 0.1, group = grpL)
showUpper = input.bool(false, "Plot upper band (never traded)", group = grpL, tooltip = "Video 8:14: the trader only uses the lower band.")

grpS = "Short - shooting star scalp"
shortOn       = input.bool(true, "Enable short module", group = grpS)
wickBodyRatio = input.float(2.0, "Upper wick >= N x body", step = 0.1, group = grpS)
lowerWickFrac = input.float(0.10, "Lower wick <= N x upper wick", step = 0.01, group = grpS)
minWickAtr    = input.float(0.0, "Min upper wick (x ATR, 0 = off)", step = 0.05, group = grpS, tooltip = "Not in the video. A tiny candle can pass the ratio tests (a 1-tick wick on a 0-tick body is technically a 'shooting star'). Raise this to demand a real rejection.")
dailyFilter   = input.bool(false, "Only short after a red previous day", group = grpS, tooltip = "Video 24:33: improved the test, but on only 60 trades, which the video itself says is not a significant sample.")
shortRiskMult = input.float(1.5, "Short sizing distance (x ATR)", step = 0.1, group = grpS, tooltip = "The video gives no sizing formula for shorts. This is the adverse move the size is calculated against.")
shortStopOn   = input.bool(true, "Max-loss stop at that distance", group = grpS, tooltip = "Sizing alone cannot cap a loss that has no exit price. The video says the trader closes early if a trade risks the max-position-loss rule (26:08); this is that rule made mechanical. Turn OFF to reproduce the video's no-stop backtest.")

grpR = "Risk & sizing"
useFixedQty = input.bool(false, "Use fixed contracts instead of risk %", group = grpR, tooltip = "Tick this and set 4 to reproduce the video's backtests.")
riskPct  = input.float(0.5, "Max loss per position (% of starting balance)", step = 0.1, group = grpR, tooltip = "Video 14:55: IQ Capital limits loss per position to 0.5% of STARTING balance on a funded account, 1% on a challenge. Starting balance = Initial capital in Properties.")
fixedQty = input.int(4, "Fixed contracts", minval = 1, group = grpR, tooltip = "The video's backtests used a static 4.")
maxQty   = input.int(20, "Max contracts", minval = 1, group = grpR)

grpT = "Session (all times New York)"
skipOpen    = input.bool(true, "Never trade the opening candle", group = grpT, tooltip = "Video 11:14: 'He never trades the opening candle.' Which open isn't stated; 09:30 assumed.")
openHHMM    = input.int(930, "Opening candle time (HHMM)", group = grpT)
skipGlobex  = input.bool(false, "Also skip the 18:00 Globex reopen candle", group = grpT)
useWindow   = input.bool(false, "Only trade inside a time window", group = grpT)
winStart    = input.int(930, "Window start (HHMM)", group = grpT)
winEnd      = input.int(1600, "Window end (HHMM)", group = grpT)
useFlatten  = input.bool(false, "Flatten everything at a fixed time", group = grpT, tooltip = "Not in the video. Stops a long from being held overnight.")
flattenHHMM = input.int(1555, "Flatten at (HHMM)", group = grpT)

// -------------------------------------------------------------------------
// TIME HELPERS
// A strategy decides at a candle's CLOSE what orders are live during the NEXT
// candle. So "don't trade the opening candle" has to be checked one candle
// early, against the next candle's open time, which is this candle's close.
// -------------------------------------------------------------------------
TZ = "America/New_York"

minuteOfDay(t) => hour(t, TZ) * 60 + minute(t, TZ)
hhmmToMin(v) => math.floor(v / 100) * 60 + v % 100

thisBarMin = minuteOfDay(time)        // the candle that just closed
nextBarMin = minuteOfDay(time_close)  // the candle any new orders will live in
openMin    = hhmmToMin(openHHMM)

isOpeningMin(m) => skipOpen and m == openMin
inWindow(m) => not useWindow or (m >= hhmmToMin(winStart) and m < hhmmToMin(winEnd))

// Next candle is the 18:00 reopen when this one closes at the 17:00 halt.
globexNext   = skipGlobex and nextBarMin == 17 * 60
globexThis   = skipGlobex and thisBarMin == 18 * 60
flattenNow   = useFlatten and nextBarMin == hhmmToMin(flattenHHMM)

nextBarBlocked   = isOpeningMin(nextBarMin) or globexNext or not inWindow(nextBarMin) or flattenNow
thisBarIsOpening = isOpeningMin(thisBarMin) or globexThis

// -------------------------------------------------------------------------
// ATR
// Evaluated at this candle's close, this value is the "previous candle's ATR"
// for everything in the next candle: the band, the target and the stop.
// That's what makes them static (11:55-12:45). The current candle's ATR moves
// with every tick; the previous candle's never changes.
// -------------------------------------------------------------------------
atrVal = ta.atr(atrLen)
atrOk = not na(atrVal) and atrVal > 0

// -------------------------------------------------------------------------
// ATR BANDS - anchored on the PREVIOUS candle's close (6:27-7:52)
// Computed now, live during the next candle. Anchoring on the current price
// would make the band move with price and it would never get touched: the
// video's own reason for the static anchor.
// -------------------------------------------------------------------------
lowerNext = math.round_to_mintick(close - bandMult * atrVal)
upperNext = math.round_to_mintick(close + bandMult * atrVal)

// -------------------------------------------------------------------------
// POSITION SIZING
// Contracts = floor(allowed loss / (stop distance x $ per point)).
// MNQ is $2 a point (syminfo.pointvalue), so 5 contracts = $10/point (13:55).
// Wider ATR -> wider stop -> fewer contracts; narrower ATR -> more.
// Commission and slippage are NOT in this sum, so a stop-out can land a
// little over the limit. Lower riskPct slightly if that matters to you.
// -------------------------------------------------------------------------
riskUsd = strategy.initial_capital * riskPct / 100.0

qtyFor(stopPts) =>
    int q = 0
    if useFixedQty
        q := fixedQty
    else
        perContract = stopPts * syminfo.pointvalue
        q := perContract > 0 ? math.floor(riskUsd / perContract) : 0
    math.min(q, maxQty)

// Exits are given to strategy.exit() in TICKS relative to the fill price.
// That locks them to the fill (a gap below the band fills at the open, a
// better price, and the target and stop move with it) and rounds them to
// MNQ's 0.25 tick (12:45).
tpTicks  = atrOk ? math.round(tpMult * atrVal / syminfo.mintick) : 0
slTicks  = atrOk ? math.round(slMult * atrVal / syminfo.mintick) : 0
longQty  = qtyFor(slTicks * syminfo.mintick)

shortStopTicks = atrOk ? math.round(shortRiskMult * atrVal / syminfo.mintick) : 0
shortQty       = qtyFor(shortStopTicks * syminfo.mintick)

// -------------------------------------------------------------------------
// DAILY FILTER (24:33)
// Previous completed day closed red. `[1]` with lookahead_on is the
// non-repainting way to read a COMPLETED higher-timeframe candle. Without the
// [1], lookahead_on leaks today's unfinished close into history.
// -------------------------------------------------------------------------
prevRedInt = request.security(syminfo.tickerid, "D", close[1] < open[1] ? 1 : 0, lookahead = barmerge.lookahead_on)
prevDayRed = nz(prevRedInt) == 1

// -------------------------------------------------------------------------
// SHOOTING STAR (17:35-18:24): the video creator's objective version
//   upper wick >= 2 x body
//   lower wick <= 1/10 of the upper wick
//   either colour
// The upper wick must exist, or a flat candle (all four prices equal) passes
// both ratio tests at 0 >= 0.
// -------------------------------------------------------------------------
body      = math.abs(close - open)
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low

isStarShape = upperWick > 0 and upperWick >= wickBodyRatio * body and lowerWick <= lowerWickFrac * upperWick
isStarSize  = minWickAtr <= 0 or upperWick >= minWickAtr * atrVal
isStar      = isStarShape and isStarSize

// -------------------------------------------------------------------------
// STATE: record the locked exits when a long fills
// Read BEFORE this candle places new orders, so we get the values from the
// order that actually filled rather than the next one.
// -------------------------------------------------------------------------
var float pendAtr     = na
var int   pendTpTicks = 0
var int   pendSlTicks = 0

var float lockAtr = na
var float lockTp  = na
var float lockSl  = na

justLong = strategy.position_size > 0 and strategy.position_size[1] <= 0
if justLong
    entryPx = strategy.position_avg_price
    lockAtr := pendAtr
    lockTp  := entryPx + pendTpTicks * syminfo.mintick
    lockSl  := entryPx - pendSlTicks * syminfo.mintick
if strategy.position_size <= 0
    lockAtr := na
    lockTp  := na
    lockSl  := na

flat = strategy.position_size == 0

// -------------------------------------------------------------------------
// SHORT: TIME EXIT (19:18-19:48)
// The short was entered at the open of the candle that just closed. At its
// close, buy back, which fills at the NEXT open: one candle, five minutes,
// "no matter what". Any open short at a candle's close is exited this way.
// -------------------------------------------------------------------------
if strategy.position_size < 0
    strategy.close("Short", comment = "1-candle time exit")

if flattenNow and strategy.position_size != 0
    strategy.close_all(comment = "Flatten time")

// -------------------------------------------------------------------------
// SHORT: ENTRY
// The signal candle has closed, so sell at market, which fills at the next
// open (18:24-18:40). Skipped when:
//   * the signal candle IS the opening candle (its shape is opening noise)
//   * the next candle, where the short would be held, is the opening candle
//   * a position is already open
//   * the daily filter is on and yesterday wasn't red
//   * the size works out below 1 contract
// Evaluated before the long so it can pull the long limit (see below).
// -------------------------------------------------------------------------
shortTimingOk = not thisBarIsOpening and not nextBarBlocked
shortFilterOk = not dailyFilter or prevDayRed
shortSignal   = shortOn and atrOk and flat and isStar and shortTimingOk and shortFilterOk and shortQty >= 1

if shortSignal
    strategy.entry("Short", strategy.short, qty = shortQty, comment = "Shooting star")
    if shortStopOn
        strategy.exit("S-X", from_entry = "Short", loss = shortStopTicks, comment_loss = "Max-loss stop")

// -------------------------------------------------------------------------
// LONG: THE FOLLOWING LIMIT ORDER (8:33-8:42)
// "Wherever the lower band goes, there's a limit order following it." While
// flat, re-place the limit at this candle's band every candle. Using the same
// order ID replaces the old one. The target and stop are placed alongside it
// and only become active once it fills.
//
// STATIC EXITS: the exit is only (re)issued while FLAT. Once the limit fills
// it's never touched again, so the target and stop stay exactly where the
// previous candle's ATR put them, however ATR moves afterwards.
//
// The limit is pulled for the next candle when that candle is the opening
// candle, is outside the window, or is the candle a short is being held in.
// -------------------------------------------------------------------------
longAllowed = longOn and atrOk and flat and not nextBarBlocked and not shortSignal and longQty >= 1

if longAllowed
    pendAtr     := atrVal
    pendTpTicks := tpTicks
    pendSlTicks := slTicks
    strategy.entry("Long", strategy.long, qty = longQty, limit = lowerNext, comment = "ATR band")
    strategy.exit("L-X", from_entry = "Long", profit = tpTicks, loss = slTicks, comment_profit = "TP 2 ATR", comment_loss = "SL 1.5 ATR")
else if flat
    strategy.cancel("Long")
    strategy.cancel("L-X")

// -------------------------------------------------------------------------
// VISUALS
// The band live on each candle is the one computed at the PREVIOUS close,
// hence [1]. That's the price the limit order sat at during this candle.
// -------------------------------------------------------------------------
plot(lowerNext[1], "Lower ATR band (live limit)", color.new(color.red, 0), 1, plot.style_stepline)
plot(showUpper ? upperNext[1] : na, "Upper ATR band (not traded)", color.new(color.gray, 50), 1, plot.style_stepline)

plot(lockTp, "Locked target", color.new(color.teal, 0), 2, plot.style_linebr)
plot(lockSl, "Locked stop", color.new(color.red, 0), 2, plot.style_linebr)

plotshape(shortSignal, "Short signal (sell next open)", shape.triangledown, location.abovebar, color.new(color.orange, 0), size = size.tiny)
plotshape(shortOn and isStar and not shortSignal, "Star filtered out", shape.xcross, location.abovebar, color.new(color.gray, 40), size = size.tiny)

bgcolor(thisBarIsOpening ? color.new(color.gray, 85) : na, title = "Opening candle (no trading)")

// Status panel: what the next candle will trade with.
var table info = table.new(position.top_right, 2, 9, bgcolor = color.new(color.black, 25), border_color = color.new(color.gray, 70), border_width = 1)

cellTxt(r, k, v) =>
    table.cell(info, 0, r, k, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(info, 1, r, v, text_color = color.white, text_size = size.small, text_halign = text.align_right)

if barstate.islastconfirmedhistory or barstate.isrealtime
    cellTxt(0, "ATR (prev candle)", atrOk ? str.tostring(atrVal, "#.##") : "-")
    cellTxt(1, "Lower band (next)", str.tostring(lowerNext, format.mintick))
    cellTxt(2, "Long size / stop", str.tostring(longQty) + " / " + str.tostring(slTicks * syminfo.mintick, "#.##") + " pts")
    cellTxt(3, "Short size / dist", str.tostring(shortQty) + " / " + str.tostring(shortStopTicks * syminfo.mintick, "#.##") + " pts")
    cellTxt(4, "Max loss / position", "$" + str.tostring(riskUsd, "#,###"))
    cellTxt(5, "Previous day", prevDayRed ? "red (shorts OK)" : "green")
    cellTxt(6, "Locked TP / SL", na(lockTp) ? "-" : str.tostring(lockTp, format.mintick) + " / " + str.tostring(lockSl, format.mintick))
    cellTxt(7, "Locked ATR (in trade)", na(lockAtr) ? "-" : str.tostring(lockAtr, "#.##"))
    cellTxt(8, "Next candle", nextBarBlocked ? "BLOCKED" : "tradeable")
