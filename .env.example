# IC Markets cTrader Open API credentials.
# Copy this file to .env and fill in real values. Never commit .env.
#
# How to get these values: docs/setup_icmarkets.md

# Application credentials (from openapi.ctrader.com after app approval)
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=

# OAuth tokens (from scripts/ctrader_token_helper.py one-shot exchange)
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=

# cTrader internal `ctidTraderAccountId` (NOT the 7-8 digit account number from
# the IC Markets welcome email — that one is `traderLogin`, a different value).
# To discover the right ID, run: python3 scripts/ctrader_smoke.py
# It walks the protobuf chain and prints both ctidTraderAccountId + traderLogin.
CTRADER_ACCOUNT_ID=
CTRADER_ENVIRONMENT=demo     # "demo" | "live"

# Protocol endpoints — defaults are Spotware's public hosts, don't override unless you have a reason
CTRADER_DEMO_HOST=demo.ctraderapi.com
CTRADER_LIVE_HOST=live.ctraderapi.com
CTRADER_PORT=5035
