<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.algo-trading.xauusd-refresh</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.11/bin/python3</string>
        <string>scripts/download_xauusd.py</string>
        <string>--years</string>
        <string>8.75</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/prince/algo-trading</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/prince/algo-trading</string>
    </dict>

    <!-- Daily 21:17 local (off-minute jitter per ops hygiene). Keeps
         data/historical/XAUUSD_1h.parquet < 24h fresh so the gold engine's
         60h warmup-recency tolerance is never exceeded — fixes the Session 29
         re-staleness (cache went stale ~2.5d after each manual refresh, which
         starved donchian_gold's warmup on restart). download_xauusd.py uses
         REPLACE semantics -- it OVERWRITES the parquet with exactly the
         requested window, it does not merge. At --years 2.0 this silently
         truncated the research history from 619,590 bars (2017-12-18) back to
         141,516 (2024-09-15) on 2026-09-15, mid-run. Raised to 8.75y so the
         one file serves both the gold engine's freshness requirement and the
         walk-forward's need for history. Do not lower it without moving
         research to its own differently-named file. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>21</integer>
        <key>Minute</key>
        <integer>17</integer>
    </dict>

    <!-- One-shot daily job, not a daemon. -->
    <key>RunAtLoad</key>
    <false/>

    <key>ThrottleInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>/Users/prince/algo-trading/data/logs/xauusd_refresh.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/prince/algo-trading/data/logs/xauusd_refresh_err.log</string>
</dict>
</plist>
