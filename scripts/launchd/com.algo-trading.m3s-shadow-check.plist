<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.algo-trading.m3s-shadow-check</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.11/bin/python3</string>
        <string>scripts/m3s_shadow_check.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/prince/algo-trading</string>

    <!-- Fire once at load, then every 6h (21600s). -->
    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>21600</integer>

    <!-- Not a long-running daemon — this is a cron-style periodic job.
         Do NOT set KeepAlive; that would relaunch immediately after exit. -->

    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/Users/prince/algo-trading/data/logs/m3s_shadow_check.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/prince/algo-trading/data/logs/m3s_shadow_check_err.log</string>
</dict>
</plist>
