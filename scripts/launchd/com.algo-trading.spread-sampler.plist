<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.algo-trading.spread-sampler</string>

    <!-- 240-minute XAUUSD spread capture during London/NY peak overlap.
         Weekly so we get spread drift data over time, not just a one-off. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.11/bin/python3</string>
        <string>-u</string>
        <string>scripts/ctrader_spread_sampler.py</string>
        <string>--minutes</string>
        <string>240</string>
        <string>--symbol</string>
        <string>XAUUSD</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/prince/algo-trading</string>

    <!-- Fire every Monday at 18:30 IST = 13:00 UTC (start of London/NY peak overlap).
         Captures 13:00-17:00 UTC each week (4 hours covering the deepest liquidity). -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- Not a daemon: it runs to completion then exits. Do NOT set KeepAlive. -->

    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/Users/prince/algo-trading/data/logs/spread_sampler.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/prince/algo-trading/data/logs/spread_sampler_err.log</string>
</dict>
</plist>
