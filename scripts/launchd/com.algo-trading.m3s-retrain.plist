<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.algo-trading.m3s-retrain</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.11/bin/python3</string>
        <string>scripts/train_meta_classifier.py</string>
        <string>--all</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/prince/algo-trading</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/prince/algo-trading</string>
    </dict>

    <!-- Weekly Sunday 00:03 UTC (off-minute jitter per ops hygiene).
         Retrains on ALL audit rows accumulated since the last retrain,
         including live data from the past week. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>0</integer>
        <key>Minute</key>
        <integer>3</integer>
    </dict>

    <!-- Not a long-running daemon — one-shot weekly job. -->
    <key>RunAtLoad</key>
    <false/>

    <key>ThrottleInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>/Users/prince/algo-trading/data/logs/m3s_retrain.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/prince/algo-trading/data/logs/m3s_retrain_err.log</string>
</dict>
</plist>
